<div x-data="{ open: false, justAdded: '' }"
     @cart-added.window="open = true; justAdded = $event.detail.name"
     @open-cart.window="open = true; justAdded = ''"
     @close-cart.window="open = false; justAdded = ''"
     @keydown.escape.window="open = false; justAdded = ''">

    
    <div x-show="open" x-cloak
         x-transition:enter="transition duration-400 ease-out" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
         x-transition:leave="transition duration-300 ease-in" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         class="cart-backdrop fixed inset-0 z-50 bg-ink/35 backdrop-blur-[2px]"
         @click="open = false; justAdded = ''"></div>

    
    <aside x-show="open" x-cloak
           x-transition:enter="transition duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
           x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
           x-transition:leave="transition duration-300 ease-in"
           x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
           class="cart-panel fixed right-0 top-0 z-50 flex h-dvh w-full max-w-md flex-col border-l border-line-soft bg-ivory"
           style="box-shadow: -30px 0 80px -30px rgb(20 20 19 / .25)">

        <header class="flex items-center justify-between border-b border-line-soft px-6 py-5">
            <div>
                <h2 class="display text-xl font-semibold">
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($step === 'success'): ?> <?php echo e(__('site.cart.your_licenses')); ?> <?php else: ?> <?php echo e(__('site.cart.your_cart')); ?> <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                </h2>
                <p class="text-[13px] text-muted">
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($step === 'success'): ?>
                        <?php echo e(count($issuedKeys) === 1 ? __('site.cart.key_delivered', ['count' => count($issuedKeys)]) : __('site.cart.keys_delivered', ['count' => count($issuedKeys)])); ?>

                    <?php else: ?>
                        <?php echo e($count === 0 ? __('site.cart.empty_note') : __('site.cart.licenses_count', ['count' => $count])); ?>

                    <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                </p>
            </div>
            <button @click="open = false; justAdded = ''"
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-line transition hover:border-ink/30 hover:bg-cream"
                    aria-label="<?php echo e(__('site.nav.close_cart')); ?>">
                <svg viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </header>

        <div x-show="justAdded" x-cloak
             x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
             class="border-b border-line-soft bg-accent-soft px-6 py-3">
            <p class="flex items-center gap-2 text-[13px] font-medium text-accent-deep">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 12.5l5 5 10-11"/>
                </svg>
                <?php echo e(__('site.cart.added')); ?> “<span x-text="justAdded"></span>”
            </p>
        </div>

        
        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($step === 'success'): ?>
            <div class="flex-1 overflow-y-auto px-6 py-6">
                <div class="mb-6 flex items-center gap-3.5">
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent text-ivory">
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4.5 12.5l5 5 10-11"/>
                        </svg>
                    </span>
                    <div>
                        <p class="display text-lg font-semibold"><?php echo e(__('site.cart.order_complete')); ?></p>
                        <p class="text-[13px] text-muted"><?php echo e(__('site.cart.valid_for', ['email' => $email])); ?></p>
                    </div>
                </div>

                <ul class="space-y-4">
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = $issuedKeys; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $i => $item): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                        <li class="rounded-2xl border border-line-soft bg-white/80 p-4" <?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::$currentLoop['key'] = 'key-'.e($i).''; ?>wire:key="key-<?php echo e($i); ?>">
                            <div class="flex items-center justify-between">
                                <p class="text-[14px] font-medium"><?php echo e($item['product']); ?> <span class="text-faint">· v<?php echo e($item['version']); ?></span></p>
                                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($item['download']): ?>
                                    <a href="<?php echo e($item['download']); ?>" class="text-[12px] font-medium text-accent-deep link-underline"><?php echo e(__('site.cart.download')); ?></a>
                                <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                            </div>
                            <div class="mt-2.5 flex items-center gap-2" x-data="{ copied: false }">
                                <code class="flex-1 rounded-xl border border-line bg-cream/70 px-3 py-2.5 font-mono text-[13px] tracking-wide select-all"><?php echo e($item['key']); ?></code>
                                <button class="qty-btn h-10 shrink-0 px-3 text-[12px] font-medium"
                                        @click="navigator.clipboard.writeText('<?php echo e($item['key']); ?>'); copied = true; setTimeout(() => copied = false, 1600)">
                                    <span x-show="!copied"><?php echo e(__('site.cart.copy')); ?></span>
                                    <span x-show="copied" x-cloak class="text-sage-deep"><?php echo e(__('site.cart.copied')); ?></span>
                                </button>
                            </div>
                        </li>
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
                </ul>

                <p class="mt-6 text-[12.5px] leading-relaxed text-muted">
                    <?php echo e(__('site.cart.keep_keys')); ?>

                    <a href="<?php echo e(route('license')); ?>" @click="open = false" class="link-underline text-ink"><?php echo e(__('site.nav.check_license')); ?></a>.
                </p>
            </div>

            <footer class="border-t border-line-soft bg-cream/50 px-6 py-5">
                <button @click="open = false" class="btn-ink w-full py-3.5 text-sm"><?php echo e(__('site.cart.continue')); ?></button>
            </footer>

        
        <?php else: ?>
            <div class="flex-1 overflow-y-auto px-6 py-5">
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($lines->isEmpty()): ?>
                    <div class="flex h-full flex-col items-center justify-center gap-5 text-center">
                        <span class="flex h-24 w-24 items-center justify-center rounded-full bg-cream">
                            <svg viewBox="0 0 24 24" class="h-10 w-10 text-faint" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 8h12l1.2 12.2a1.6 1.6 0 0 1-1.6 1.8H6.4a1.6 1.6 0 0 1-1.6-1.8L6 8z"/>
                                <path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>
                            </svg>
                        </span>
                        <div>
                            <p class="display text-lg"><?php echo e(__('site.cart.empty_title')); ?></p>
                            <p class="mt-1 text-sm text-muted"><?php echo e(__('site.cart.empty_body')); ?></p>
                        </div>
                        <button @click="open = false" class="btn-primary px-6 py-3 text-sm"><?php echo e(__('site.cart.browse')); ?></button>
                    </div>
                <?php else: ?>
                    <ul class="space-y-5">
                        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = $lines; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $i => $line): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
                            <?php $product = $line['product']; ?>
                            <li class="flex gap-4" <?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::$currentLoop['key'] = 'cart-'.e($product->id).''; ?>wire:key="cart-<?php echo e($product->id); ?>">
                                <a href="<?php echo e(route('product.show', $product->slug)); ?>" @click="open = false" class="shrink-0">
                                    <img src="<?php echo e($product->image_url); ?>" alt="<?php echo e($product->name); ?>"
                                         class="h-20 w-20 rounded-2xl border border-line-soft bg-cream object-cover">
                                </a>
                                <div class="flex flex-1 flex-col">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <a href="<?php echo e(route('product.show', $product->slug)); ?>" @click="open = false"
                                               class="text-[14.5px] font-medium leading-snug hover:text-accent-deep"><?php echo e($product->name); ?></a>
                                            <p class="mt-0.5 text-[12px] text-faint"><?php echo e(__('site.cart.lifetime_each', ['price' => number_format($product->price_cents / 100, 0)])); ?></p>
                                        </div>
                                        <button wire:click="remove(<?php echo e($product->id); ?>)"
                                                class="mt-0.5 text-faint transition-colors hover:text-accent-deep" aria-label="Remove">
                                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                                                <path d="M6 6l12 12M18 6L6 18"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="mt-auto flex items-center justify-between pt-2">
                                        <div class="flex items-center gap-1">
                                            <button wire:click="decrease(<?php echo e($product->id); ?>)" class="qty-btn h-8 w-8" aria-label="Less">−</button>
                                            <span class="w-8 text-center text-sm font-medium"><?php echo e($line['qty']); ?></span>
                                            <button wire:click="increase(<?php echo e($product->id); ?>)" class="qty-btn h-8 w-8" aria-label="More">+</button>
                                        </div>
                                        <span class="text-[14px] font-semibold">$<?php echo e(number_format($product->price_cents * $line['qty'] / 100, 0)); ?></span>
                                    </div>
                                </div>
                            </li>
                        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::endLoop(); ?><?php endif; ?><?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::closeLoop(); ?><?php endif; ?>
                    </ul>

                    <button wire:click="clear" class="mt-7 text-[13px] text-faint underline-offset-4 transition-colors hover:text-accent-deep hover:underline">
                        <?php echo e(__('site.cart.empty_cart')); ?>

                    </button>
                <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
            </div>

            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($lines->isNotEmpty()): ?>
                <footer class="border-t border-line-soft bg-cream/50 px-6 py-5">
                    <div class="mb-1.5 flex items-center justify-between text-sm">
                        <span class="text-muted"><?php echo e(__('site.cart.subtotal')); ?></span>
                        <span class="display text-xl font-semibold"><?php echo e($subtotal); ?></span>
                    </div>
                    <p class="mb-4 text-[12px] text-faint"><?php echo e(__('site.cart.instant_note')); ?></p>

                    <form wire:submit="checkout" class="space-y-3">
                        <input type="email" wire:model="email" placeholder="<?php echo e(__('site.cart.email_placeholder')); ?>" class="field rounded-full">
                        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php $__errorArgs = ['email'];
$__bag = $errors->getBag($__errorArgs[1] ?? 'default');
if ($__bag->has($__errorArgs[0])) :
if (isset($message)) { $__messageOriginal = $message; }
$message = $__bag->first($__errorArgs[0]); ?> <p class="-mt-1 pl-2 text-[12px] text-accent-deep"><?php echo e($message); ?></p> <?php unset($message);
if (isset($__messageOriginal)) { $message = $__messageOriginal; }
endif;
unset($__errorArgs, $__bag); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php $__errorArgs = ['checkout'];
$__bag = $errors->getBag($__errorArgs[1] ?? 'default');
if ($__bag->has($__errorArgs[0])) :
if (isset($message)) { $__messageOriginal = $message; }
$message = $__bag->first($__errorArgs[0]); ?> <p class="-mt-1 pl-2 text-[12px] text-accent-deep"><?php echo e($message); ?></p> <?php unset($message);
if (isset($__messageOriginal)) { $message = $__messageOriginal; }
endif;
unset($__errorArgs, $__bag); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>

                        <button type="submit" class="btn-primary w-full py-3.5 text-sm" wire:loading.attr="disabled">
                            <?php echo e(__('site.cart.checkout')); ?>

                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14M13 6l6 6-6 6"/>
                            </svg>
                        </button>
                    </form>
                    <p class="mt-3 text-center text-[11.5px] text-faint"><?php echo e(__('site.cart.demo_note')); ?></p>
                </footer>
            <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
        <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
    </aside>
</div>
