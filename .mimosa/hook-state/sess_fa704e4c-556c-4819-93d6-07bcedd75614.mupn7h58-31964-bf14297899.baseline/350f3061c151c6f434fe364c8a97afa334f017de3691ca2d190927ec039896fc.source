    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::openLoop(); ?><?php endif; ?><?php $__currentLoopData = [
            ['label' => 'Products', 'value' => number_format($productCount), 'tint' => 'bg-accent-soft text-accent-deep'],
            ['label' => 'Keys available', 'value' => number_format($availableKeys), 'tint' => 'bg-sage/20 text-sage-deep'],
            ['label' => 'Keys issued', 'value' => number_format($issuedKeys), 'tint' => 'bg-cream text-ink-soft'],
            ['label' => 'Revenue', 'value' => '$' . number_format($revenueCents / 100, 0), 'tint' => 'bg-ink text-ivory'],
        ]; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $stat): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><?php \Livewire\Features\SupportCompiledWireKeys\SupportCompiledWireKeys::startLoopIteration(); ?><?php endif; ?>
            <div class="rounded-[22px] border border-line-soft bg-white/80 p-5 shadow-soft">
                <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-muted"><?php echo e($stat['label']); ?></p>
                <p class="display mt-2 text-3xl font-semibold <?php echo e($stat['tint'] === 'bg-ink text-ivory' ? '' : ''); ?>"><?php echo e($stat['value']); ?></p>
